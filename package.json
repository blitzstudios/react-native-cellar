{
  "name": "@sleeperhq/react-native-cellar",
  "version": "1.2.5",
  "description": "Keeps a React Native app's large server data off the JS heap, in SQLite, while components read it synchronously and re-render only for what changed.",
  "keywords": [
    "react-native",
    "react",
    "sqlite",
    "off-heap",
    "reactivity",
    "data-layer",
    "cache",
    "hermes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blitzstudios/react-native-cellar.git"
  },
  "homepage": "https://github.com/blitzstudios/react-native-cellar#readme",
  "bugs": {
    "url": "https://github.com/blitzstudios/react-native-cellar/issues"
  },
  "license": "MIT",
  "main": "./lib/module/index",
  "module": "./lib/module/index",
  "types": "./lib/typescript/module/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./nitro": {
      "import": {
        "types": "./lib/typescript/module/nitro/index.d.ts",
        "default": "./lib/module/nitro/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/nitro/index.d.ts",
        "default": "./lib/commonjs/nitro/index.js"
      }
    },
    "./sqljs": {
      "import": {
        "types": "./lib/typescript/module/sqljs/index.d.ts",
        "default": "./lib/module/sqljs/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/sqljs/index.d.ts",
        "default": "./lib/commonjs/sqljs/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./lib/typescript/module/testing/index.d.ts",
        "default": "./lib/module/testing/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/testing/index.d.ts",
        "default": "./lib/commonjs/testing/index.js"
      }
    },
    "./diagnostics": {
      "import": {
        "types": "./lib/typescript/module/diagnostics/index.d.ts",
        "default": "./lib/module/diagnostics/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/diagnostics/index.d.ts",
        "default": "./lib/commonjs/diagnostics/index.js"
      }
    },
    "./redux": {
      "import": {
        "types": "./lib/typescript/module/redux/index.d.ts",
        "default": "./lib/module/redux/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/redux/index.d.ts",
        "default": "./lib/commonjs/redux/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "nitro/package.json",
    "sqljs/package.json",
    "testing/package.json",
    "diagnostics/package.json",
    "redux/package.json",
    "!**/tests",
    "!**/*.test.ts",
    "!**/*.probe.ts"
  ],
  "scripts": {
    "build": "yarn typecheck && bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:prod": "jest --config jest.config.prod.js",
    "test:all": "yarn test && yarn test:prod",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "@tanstack/query-core": ">=4",
    "react": ">=17",
    "react-native": ">=0.70",
    "react-native-nitro-modules": ">=0.35",
    "react-native-nitro-sqlite": ">=1.1.4",
    "use-sync-external-store": ">=1.2.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    },
    "react-native-nitro-sqlite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/query-core": "4.41.0",
    "@types/jest": "^29.5.12",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "@types/sql.js": "^1.4.9",
    "@types/use-sync-external-store": "^0.0.6",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native-builder-bob": "^0.31.0",
    "react-native-nitro-sqlite": "blitzstudios/react-native-nitro-sqlite.git#react-native-nitro-sqlite-v1.1.5-gitpkg",
    "react-test-renderer": "19.2.3",
    "sql.js": "1.13.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5",
    "use-sync-external-store": "1.6.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{tests/**,*.test.ts,*.probe.ts}",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  },
  "packageManager": "yarn@4.14.1"
}
